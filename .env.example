# Public canonical origin. Production validation requires a real HTTPS origin.
NEXT_PUBLIC_SITE_URL=

# Optional Google Analytics for Firebase. Collection stays disabled unless the
# flag is true, every public identifier is present, and the visitor opts in.
NEXT_PUBLIC_FIREBASE_ANALYTICS_ENABLED=false
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Leave all contact values empty to keep delivery fail-closed.
# Set all values together only after the destination and privacy text are reviewed.
CONTACT_WEBHOOK_URL=
CONTACT_WEBHOOK_TOKEN=
CONTACT_PROVIDER_NAME=
CONTACT_RETENTION_NOTICE=

# Set to true in a launch environment where contact delivery is mandatory.
REQUIRE_CONTACT_DELIVERY=false

# Blog CMS: disabled until server and client project configuration is verified.
BLOG_ENABLED=false
BLOG_FIREBASE_PROJECT_ID=
BLOG_STORAGE_BUCKET=
BLOG_RATE_LIMIT_MODE=identity-global
BLOG_RATE_LIMIT_SECRET=
# Set ONLY after verifying the ingress overwrites this header.
BLOG_TRUSTED_IP_HEADER=
NEXT_PUBLIC_BLOG_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_BLOG_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_BLOG_FIREBASE_API_KEY=
# Local emulator only: demo-* project; all three services must be configured.
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199
# NEXT_PUBLIC_BLOG_AUTH_EMULATOR_URL=http://127.0.0.1:9099

# Optional Google One Tap; Web OAuth client ID from the same Firebase project.
NEXT_PUBLIC_BLOG_ONE_TAP_ENABLED=false
NEXT_PUBLIC_BLOG_GOOGLE_CLIENT_ID=
